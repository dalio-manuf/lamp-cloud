<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <!--
            本工程依赖底层的 lamp-util 基础组件库。
            在初次构建前，请确保 lamp-util (5.10.0) 已编译并安装至本地或私有 Maven 仓库。
        -->
        <groupId>com.dalio.basic</groupId>
        <artifactId>lamp-parent</artifactId>
        <version>5.10.0</version>
        <relativePath/>
    </parent>

    <groupId>com.dalio.cloud</groupId>
    <artifactId>lamp-dependencies-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>lamp微服务业务工程统一父POM与依赖治理中心</description>

    <properties>
        <!-- 本工程业务模块统一版本 -->
        <revision>5.10.0</revision>
        <!-- lamp-util基础组件库版本 -->
        <lamp-util.version>5.10.0</lamp-util.version>
        <!-- Docker镜像仓库前缀 -->
        <docker.image.prefix>cloud</docker.image.prefix>
        <!-- OpenAPI 规范文档组件版本（与lamp-parent及Spring Boot 3.5.x保持一致） -->
        <springdoc.version>2.8.5</springdoc.version>
        <!-- 辅助构建插件版本 -->
        <versions-maven-plugin.version>2.18.0</versions-maven-plugin.version>
        <!-- 默认跳过单元测试，单测执行时通过 -DskipTests=false 开启 -->
        <skipTests>true</skipTests>
        <!-- JaCoCo 覆盖率插件版本 -->
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ======================================================= -->
            <!-- 1. 底层基础库 BOM 引入 (lamp-util)                         -->
            <!-- ======================================================= -->
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-bom</artifactId>
                <version>${lamp-util.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- lamp-util 常用业务Starter显式声明（保证各模块精确版本控制） -->
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-all-cloud</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-all-boot</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-annotation</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-webmvc</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-cache-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-cloud-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-core</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-databases</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-echo-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-log-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-captcha-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-mq-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-mvc</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-scan-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-swagger2-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-uid</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-validator-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>lamp-xss-starter</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.basic</groupId>
                <artifactId>fastdfs-client</artifactId>
                <version>${lamp-util.version}</version>
            </dependency>

            <!-- ======================================================= -->
            <!-- 2. 本项目公共 SDK 与基础设施模块 (com.dalio.cloud)           -->
            <!-- ======================================================= -->
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-model</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-common-config</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-file-sdk</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-data-scope-sdk</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-sa-token-ext</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-login-user-facade</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-login-user-resolver</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-login-user-boot-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-login-user-cloud-impl</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================================================= -->
            <!-- 3. 本项目业务域模块 (com.dalio.cloud)                        -->
            <!-- ======================================================= -->
            <!-- lamp-oauth 认证服务 -->
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-oauth-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-oauth-boot-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-oauth-cloud-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-oauth-entity</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-oauth-controller</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-oauth-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-oauth-server</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- lamp-base 基础服务 -->
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-base-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-base-boot-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-base-cloud-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-base-entity</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-base-controller</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-base-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-base-server</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- lamp-system 系统服务 -->
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-system-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-system-boot-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-system-cloud-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-system-entity</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-system-controller</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-system-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-system-server</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- lamp-generator 代码生成服务 -->
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-generator-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-generator-entity</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-generator-controller</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-generator-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-generator-server</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- lamp-gateway 网关服务 -->
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-gateway-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-gateway-server</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- lamp-support 支撑模块 -->
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-boot-server-none</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-job-executor-none</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.dalio.cloud</groupId>
                <artifactId>lamp-monitor</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================================================= -->
            <!-- 4. 第三方扩展组件                                        -->
            <!-- ======================================================= -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全局通用基础依赖 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <!-- 全局测试套件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <profile.active>dev</profile.active>
            </properties>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <profile.active>prod</profile.active>
            </properties>
        </profile>
    </profiles>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- 单元测试插件 -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <skipTests>${skipTests}</skipTests>
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Docker 打包插件版本与通用构建参数管理 -->
                <plugin>
                    <groupId>com.spotify</groupId>
                    <artifactId>dockerfile-maven-plugin</artifactId>
                    <version>${dockerfile-maven-plugin.version}</version>
                    <configuration>
                        <repository>${docker.image.prefix}/${project.artifactId}</repository>
                        <tag>${revision}</tag>
                        <buildArgs>
                            <JAR_FILE>target/${project.build.finalName}.jar</JAR_FILE>
                        </buildArgs>
                    </configuration>
                </plugin>
                <!-- 一键更新子模块版本号插件 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                    <configuration>
                        <generateBackupPoms>false</generateBackupPoms>
                    </configuration>
                </plugin>
                <!-- JaCoCo 单测覆盖率统计插件 -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- 单元测试插件 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <!-- 单测覆盖率插件 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <!-- 资源拷贝插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
            <!-- 一键更新子模块版本号 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
            </plugin>
            <!-- 代码规范检查 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
