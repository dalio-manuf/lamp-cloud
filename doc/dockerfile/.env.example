# ==========================================
# lamp-cloud 基础中间件环境变量配置模板
# 复制该文件为 .env 即可生效: cp .env.example .env
# ==========================================

# 宿主机数据持久化挂载根目录
DATA_PATH=/data/docker-data

# 系统默认时区
TZ=Asia/Shanghai

# ------------------------------------------
# MySQL 配置
# ------------------------------------------
MYSQL_VERSION=8.0.36
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lamp_none

# ------------------------------------------
# Redis 配置
# ------------------------------------------
REDIS_VERSION=7.2-alpine
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# Nacos 注册中心与配置中心
# ------------------------------------------
NACOS_VERSION=v2.3.2
NACOS_PORT=8848
NACOS_MODE=standalone

# ------------------------------------------
# RabbitMQ 消息队列
# ------------------------------------------
RABBITMQ_VERSION=3.12-management
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# ------------------------------------------
# MinIO 对象存储
# ------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
