#!groovy
pipeline {
    agent any

    // =========================================================================
    // lamp-cloud 微服务持续集成与自动化部署流水线
    // 依赖 Jenkins 参数化构建配置:
    //   - branch / BRANCH        : Git 构建分支 (默认: master / main)
    //   - SERVER_NAME            : 微服务模块名 (如: lamp-gateway, lamp-oauth, lamp-system, lamp-base, lamp-generator)
    //   - SERVER_SSH_HOST        : 目标部署主机标识 (格式: 主机名_环境名, 例如 host_dev, host_prod)
    //   - MAVEN_COMMAND          : Maven 打包命令 (package / install / none, none 表示跳过编译直接复用已有构建)
    //   - IS_PUSH_JAR            : 是否分发 JAR 包至目标主机 (true / false)
    //   - ACTION                 : 目标部署主机执行动作 (restart / start / stop / status / none)
    // =========================================================================

    environment {
        // 目标服务器临时接收构建产物的目录
        remoteDirectory = "./temp_jar/"

        // 对应微服务启动模块 JAR 名称规范
        JAR_NAME = "${SERVER_NAME}-server"

        // 推送时需裁剪的项目路径前缀
        removePrefix = "${SERVER_NAME}/${JAR_NAME}/target/"

        // 编译输出的可执行 JAR 路径
        sourceFiles = "${SERVER_NAME}/${JAR_NAME}/target/${JAR_NAME}.jar"
    }

    stages {
        stage('解析运行环境与参数') {
            steps {
                script {
                    // 解析环境标识 (从 SERVER_SSH_HOST 中提取，例如 host_prod -> prod)
                    def hostParts = "${SERVER_SSH_HOST}".tokenize('_')
                    PROFILES = hostParts.size() > 1 ? hostParts[1] : "prod"

                    // 服务端部署工作空间
                    WORKSPACE_HOME = "/data_${PROFILES}"

                    // 服务端远程运维管理命令
                    EXEC_COMMAND = "bash ${WORKSPACE_HOME}/bin/server_run.sh ${JAR_NAME} ${PROFILES} ${ACTION}"

                    def buildBranch = params.branch ?: params.BRANCH ?: env.BRANCH_NAME ?: "main"

                    echo "========== [CI/CD 构建参数走查] =========="
                    echo "代码分支: ${buildBranch}"
                    echo "服务模块: ${SERVER_NAME} (${JAR_NAME})"
                    echo "部署目标: ${SERVER_SSH_HOST} (环境: ${PROFILES})"
                    echo "构建指令: ${MAVEN_COMMAND}"
                    echo "分发产物: ${IS_PUSH_JAR}"
                    echo "执行动作: ${ACTION}"
                    echo "远程指令: ${EXEC_COMMAND}"
                    echo "=========================================="
                }
            }
        }

        stage('Maven 编译打包') {
            steps {
                script {
                    if ("${MAVEN_COMMAND}" != "none") {
                        echo "开始执行 Maven 构建: clean ${MAVEN_COMMAND} -P ${PROFILES}..."
                        sh "mvn clean ${MAVEN_COMMAND} -T2 -Dmaven.compile.fork=true -DskipTests -P ${PROFILES}"
                    } else {
                        echo "跳过 Maven 构建流程 (复用上一次编译构建产物)。"
                    }
                }
            }
        }

        stage('分发产物与服务治理') {
            steps {
                script {
                    def filesToPush = "${sourceFiles}"
                    if ("${IS_PUSH_JAR}" == "false") {
                        echo "无需分发 JAR 包至目标主机。"
                        filesToPush = ""
                    }

                    if ("${ACTION}" == "none") {
                        echo "执行动作指定为 none，目标主机无需重启或变更服务。"
                    }

                    echo "正在通过 SSH 推送构建产物并调用服务端脚本..."
                    sshPublisher(publishers: [
                        sshPublisherDesc(
                            configName: "${SERVER_SSH_HOST}",
                            transfers: [
                                sshTransfer(
                                    cleanRemote: false,
                                    excludes: '',
                                    execCommand: "${EXEC_COMMAND}",
                                    execTimeout: 120000,
                                    flatten: false,
                                    makeEmptyDirs: false,
                                    noDefaultExcludes: false,
                                    patternSeparator: '[, ]+',
                                    remoteDirectory: "${remoteDirectory}",
                                    remoteDirectorySDF: false,
                                    removePrefix: "${removePrefix}",
                                    sourceFiles: filesToPush
                                )
                            ],
                            usePromotionTimestamp: false,
                            useWorkspaceInPromotion: false,
                            verbose: false
                        )
                    ])
                }
            }
        }
    }

    post {
        success {
            echo "服务 [${SERVER_NAME}] 持续集成与部署流程执行完毕！"
        }
        failure {
            echo "服务 [${SERVER_NAME}] 持续集成与部署流程执行失败，请检查构建或主机日志！"
        }
    }
}
